# Configuration for GenAI Teachable Machine

# PeerJS server configuration for peer-to-peer collaboration and sharing
VITE_APP_PEER_SERVER=api2.gen-ai.fi
VITE_APP_PEER_SECURE=1
VITE_APP_PEER_PORT=443
VITE_APP_PEER_KEY=peerjs
VITE_APP_PEER_URL=https://api2.gen-ai.fi

# Backend API server configuration (leave empty to use same-origin / Netlify Functions + P2P fallback)
VITE_APP_API=

# Feedback server URL (optional)
VITE_FEEDBACK_URL=
