# Configuration for GenAI Teachable Machine

# PeerJS server configuration for peer-to-peer collaboration and sharing
# Khi chạy cục bộ trên máy: dùng localhost
# Khi kết nối điện thoại/tablet cùng mạng Wi-Fi: thay localhost bằng IP máy tính (vd: 192.168.1.x)
VITE_APP_PEER_SERVER=localhost
VITE_APP_PEER_SECURE=0
VITE_APP_PEER_PORT=9000
VITE_APP_PEER_KEY=peerjs
VITE_APP_PEER_URL=http://localhost:9000

# Backend API server configuration (defaults to http://localhost:9001 if omitted)
VITE_APP_API=

# Feedback server URL (optional)
VITE_FEEDBACK_URL=
